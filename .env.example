# Surreal Investigate environment example

# Server
PORT=3000
SURREAL_URL=ws://127.0.0.1:8000/rpc
SURREAL_NS=surreal_investigate
SURREAL_DB=main
SURREAL_USER=root
SURREAL_PASS=root
INDEX_JOB_TIMEOUT_MS=1200000

# AI provider (OpenAI-compatible chat/completions endpoint)
# Default points to OpenRouter if omitted.
AI_PROVIDER_URL=https://openrouter.ai/api/v1/chat/completions
AI_API_KEY=sk-or-v1-your-key-here
AI_MODEL=qwen/qwen3-32b

# Backward-compatible aliases (optional)
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1/chat/completions
# OPENROUTER_API_KEY=sk-or-v1-your-key-here
# OPENROUTER_MODEL=qwen/qwen3-32b
